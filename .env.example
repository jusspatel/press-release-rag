# Google Gemini API Key (Used for Self-RAG Generation, Critique & Synthesis)
GOOGLE_API_KEY="your-google-gemini-api-key"

# Exa AI API Key (Used for Corrective RAG Neural Web Fallback Search)
EXA_API_KEY="your-exa-api-key"

# LangSmith Observability & Tracing (Optional but Recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="your-langchain-api-key"
LANGCHAIN_PROJECT="pib-governance-intelligence"

# Router Engine Backend: "gemini" (recommended, zero-shot structured output) or "local" (Qwen 2.5 1.5B)
ROUTER_BACKEND="gemini"
# Gemini model for routing (e.g., "gemini-3.5-flash-lite" or "gemini-1.5-flash")
ROUTER_GEMINI_MODEL="gemini-3.5-flash-lite"


